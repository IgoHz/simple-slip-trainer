{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "ignorePatterns": [
    ".ai/**",
    ".next/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "node_modules/**",
    "out/**",
    "tsconfig.tsbuildinfo"
  ],
  "overrides": [
    {
      "files": ["test/**/*.ts", "test/**/*.tsx"],
      "env": {
        "vitest": true
      }
    }
  ],
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "vitest"],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "settings": {
    "react": {
      "version": "19.2.3"
    }
  }
}
