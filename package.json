{
  "name": "simple-slip-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "type-check": "tsc --noEmit",
    "format": "oxfmt .",
    "format-check": "oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "bun run test",
    "validate": "bun run build && bun run lint && bun run type-check && bun run format-check && bun run test"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
